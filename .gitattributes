# Normalise to LF in the repository; check out native on Windows.
* text=auto eol=lf

*.py   text eol=lf
*.md   text eol=lf
*.toml text eol=lf
*.yml  text eol=lf
*.csv  text eol=lf

# Recorded captures are fixtures the README is generated from -- keep diffs
# readable but do not let anything rewrite their contents.
examples/*.csv linguist-generated=true
